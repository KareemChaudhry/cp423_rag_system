import subprocess
import sys

STEPS = [
    ("Chunking corpus", ["python", "src/chunker.py"]),
    ("Running diagnostic experiment (no-context baseline)", ["python", "src/diagnostic.py"]),
    ("Running full evaluation (BM25 + dense retrieval, generation, scoring)", ["python", "src/evaluate.py"]),
]

def run():
    for label, cmd in STEPS:
        print(f"\n{'='*60}\n{label}\n{'='*60}")
        result = subprocess.run(cmd)
        if result.returncode != 0:
            print(f"\nStep failed: {' '.join(cmd)} (exit code {result.returncode})")
            sys.exit(result.returncode)

    print("\nAll steps completed successfully.")
    print("Results:")
    print("  data/chunks/chunks.jsonl       -- chunked corpus")
    print("  eval/diagnostic_results.json   -- no-context diagnostic answers")
    print("  eval/eval_results.json         -- full evaluation (retrieval + generation)")

if __name__ == "__main__":
    run()

